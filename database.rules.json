{
  "rules": {
    "bookings": {
      ".read": true,
      ".write": true,
      "$id": {
        ".validate": "newData.hasChildren(['id','location','date','lessonLabel','block','teacher'])"
      }
    },
    "talepler": {
      ".read": true,
      ".write": true
    },
    "settings": {
      ".read": true,
      ".write": true
    },
    "teachers": {
      ".read": true,
      ".write": true
    },
    "iptalTalepleri": {
      ".read": true,
      ".write": true,
      "$key": {
        ".validate": "newData.hasChildren(['key','bookingId','durum','olusturmaZamani'])"
      }
    },
    "$diger": {
      ".read": false,
      ".write": false
    }
  }
}
